eColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontColor=#FFFFFF;fontSize=13;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="70" y="194.5" width="240" height="56" as="geometry"/></mxCell><mxCell id="card_open_2" value="&lt;b&gt;Сервер времени офиса&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#35C4AF&quot; style=&quot;font-size:11px&quot;&gt;синхронизация времени&lt;/font&gt;" style="rounded=1;arcSize=14;fillColor=#4A5D6A;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontColor=#FFFFFF;fontSize=13;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="70" y="281.5" width="240" height="56" as="geometry"/></mxCell><mxCell id="card_closed_1" value="&lt;b&gt;MQTT-брокер цеха&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#35C4AF&quot; style=&quot;font-size:11px&quot;&gt;показания датчиков с брокера цеха…&lt;/font&gt;" style="rounded=1;arcSize=14;fillColor=#4A5D6A;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontColor=#FFFFFF;fontSize=13;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="1150" y="151" width="240" height="56" as="geometry"/></mxCell><mxCell id="card_closed_2" value="&lt;b&gt;Сервер времени цеха&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#35C4AF&quot; style=&quot;font-size:11px&quot;&gt;синхронизация времени&lt;/font&gt;" style="rounded=1;arcSize=14;fillColor=#4A5D6A;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontColor=#FFFFFF;fontSize=13;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="1150" y="238" width="240" height="56" as="geometry"/></mxCell><mxCell id="card_closed_3" value="&lt;b&gt;Файловый сервер цеха&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#35C4AF&quot; style=&quot;font-size:11px&quot;&gt;обновления с флешки на файловый с…&lt;/font&gt;" style="rounded=1;arcSize=14;fillColor=#4A5D6A;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fontColor=#FFFFFF;fontSize=13;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="1150" y="325" width="240" height="56" as="geometry"/></mxCell><mxCell id="node_left" value="УЗЕЛ А" style="rounded=1;arcSize=12;fillColor=#F2F4F6;strokeColor=#B9C5CD;html=1;fontColor=#3A4D59;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="64" height="88" as="geometry"/></mxCell><mxCell id="core" value="ЯДРО" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=14;fillColor=#F2F4F6;strokeColor=#B9C5CD;html=1;fontColor=#3A4D59;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="676" y="200" width="64" height="88" as="geometry"/></mxCell><mxCell id="node_right" value="УЗЕЛ В" style="rounded=1;arcSize=12;fillColor=#F2F4F6;strokeColor=#B9C5CD;html=1;fontColor=#3A4D59;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="752" y="200" width="64" height="88" as="geometry"/></mxCell><mxCell id="usb" value="USB-носитель" style="rounded=1;arcSize=30;fillColor=#354552;strokeColor=#B9C5CD;html=1;fontColor=#FFFFFF;fontSize=11;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="577" y="348" width="110" height="34" as="geometry"/></mxCell><mxCell id="lg_head" value="Правил Синоникса: 3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=13;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="1370" height="30" as="geometry"/></mxCell><mxCell id="lg_m1" value="" style="rounded=1;arcSize=30;fillColor=#E06733;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="479" width="12" height="12" as="geometry"/></mxCell><mxCell id="lg_l1" value="1. Показания датчиков с брокера цеха на брокер офиса: MQTT-брокер цеха → MQTT-брокер офиса (из «Сеть цеха» в «Офисная сеть»): MQTT, порт не указан, двунаправленное правило." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="62" y="472" width="1348" height="26" as="geometry"/></mxCell><mxCell id="lg_m2" value="" style="rounded=1;arcSize=30;fillColor=#35C4AF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="12" height="12" as="geometry"/></mxCell><mxCell id="lg_l2" value="2. Синхронизация времени: Сервер времени офиса → Сервер времени цеха (из «Офисная сеть» в «Сеть цеха»): UDP 123, однонаправленное правило." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="62" y="498" width="1348" height="26" as="geometry"/></mxCell><mxCell id="lg_m3" value="" style="rounded=1;arcSize=30;fillColor=#FFAB4D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="538" width="12" height="12" as="geometry"/></mxCell><mxCell id="lg_l3" value="3. Обновления с флешки на файловый сервер цеха: файлы из «Офисная сеть» в «Сеть цеха»; Офисная сеть: USB-носитель на Узле А / Сеть цеха: SMB, автоматически при поступлении (PUSH); проверки: ICAP: внешний антивирус; однонаправленное правило." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="62" y="524" width="1348" height="40" as="geometry"/></mxCell><mxCell id="lg_n0" value="Размещение: на границе сегмента «Сеть цеха» со стороны сети «Офисная сеть» стоит межсетевой экран (рекомендуем, даже если его нет в описании); «Синоникс» — внутри «Сеть цеха» сразу за ним. Узел А обращён к сети «Офисная сеть», Узел В — к системам «Сеть цеха». Прямого соединения сетей в обход «Синоникса» нет." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#B9C5CD;fontSize=11;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="62" y="564" width="1348" height="40" as="geometry"/></mxCell><mxCell id="p1" value="1 · MQTT" style="rounded=1;arcSize=50;fillColor=#354552;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="332" y="213.5" width="64" height="18" as="geometry"/></mxCell><mxCell id="p2" value="2 · NTP, UDP 123" style="rounded=1;arcSize=50;fillColor=#354552;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="332" y="300.5" width="116" height="18" as="geometry"/></mxCell><mxCell id="p3" value="1 · MQTT" style="rounded=1;arcSize=50;fillColor=#354552;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="1064" y="170" width="64" height="18" as="geometry"/></mxCell><mxCell id="p4" value="2 · NTP, UDP 123" style="rounded=1;arcSize=50;fillColor=#354552;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="1012" y="257" width="116" height="18" as="geometry"/></mxCell><mxCell id="p5" value="3 · файлы, SMB, PUSH" style="rounded=1;arcSize=50;fillColor=#354552;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="986" y="344" width="142" height="18" as="geometry"/></mxCell><mxCell id="p6" value="3 · файлы с флешки" style="rounded=1;arcSize=50;fillColor=#354552;strokeColor=none;html=1;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Open Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DOpen%2BSans;" vertex="1" parent="1"><mxGeometry x="695" y="356" width="129" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>